@{
    ViewData["Title"] = "Tách File Excel";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">

                @if (ViewBag.ZipPath != null)
                {
                    <div class="mb-3 d-flex gap-2">
                        <a href="@Url.Action("DownloadZip", "Excel", new { filePath = ViewBag.ZipPath })"
                           class="btn btn-success btn-lg flex-fill">
                            <i class="bi bi-download"></i> Tải về tất cả (@ViewBag.TotalFiles file)
                        </a>
                        <button type="button" onclick="clearForm()" class="btn btn-secondary btn-lg">
                            <i class="bi bi-arrow-counterclockwise"></i> Tách file mới
                        </button>
                    </div>
                }

                <div class="btn btn-success btn-lg flex-fill">
                    <h3 class="mb-0"><i class="bi bi-file-earmark-excel"></i> Tách File Excel</h3>
                </div>
                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                        </div>
                    }

                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @ViewBag.Success
                        </div>

                        <div class="mb-3">
                            <a href="@Url.Action("DownloadZip", "Excel", new { filePath = ViewBag.ZipPath })"
                               class="btn btn-success btn-lg">
                                <i class="bi bi-download"></i> Tải về tất cả (@ViewBag.TotalFiles file)
                            </a>
                        </div>

                        @if (ViewBag.Files != null)
                        {
                            <h5>Danh sách file:</h5>
                            <div class="list-group">
                                @foreach (var file in ViewBag.Files)
                                {
                                    <div class="list-group-item">
                                        <i class="bi bi-file-earmark-excel text-success"></i>
                                        <strong>@file.FileName</strong>
                                        <span class="badge bg-info">@file.RowCount dòng</span>
                                    </div>
                                }
                            </div>
                        }
                    }

                    <form method="post" enctype="multipart/form-data" asp-action="Upload" asp-controller="Excel" class="mt-4">
                        <div class="mb-3">
                            <label for="excelFile" class="form-label">Chọn file Excel:</label>
                            <input type="file"
                                   class="form-control"
                                   id="excelFile"
                                   name="excelFile"
                                   accept=".xlsx"
                                   required>
                            <div class="form-text">Chỉ chấp nhận file .xlsx</div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="headerRow" class="form-label">Hàng tiêu đề:</label>
                                <input type="number"
                                       class="form-control"
                                       id="headerRow"
                                       name="headerRow"
                                       min="1"
                                       value="@(ViewBag.HeaderRow ?? 1)"
                                       required>
                                <div class="form-text">Hàng dùng làm tiêu đề</div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="startRow" class="form-label">Hàng bắt đầu tách:</label>
                                <input type="number"
                                       class="form-control"
                                       id="startRow"
                                       name="startRow"
                                       min="1"
                                       value="@(ViewBag.StartRow ?? 2)"
                                       required>
                                <div class="form-text">Hàng dữ liệu đầu tiên</div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="splitColumn" class="form-label">Cột để tách:</label>
                                <input type="text"
                                       class="form-control"
                                       id="splitColumn"
                                       name="splitColumn"
                                       value="@(ViewBag.SplitColumn ?? "A")"
                                       placeholder="A hoặc 1"
                                       required>
                                <div class="form-text">Nhập số (1, 2...) hoặc chữ (A, B...)</div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg flex-fill" style="width: 100%;">
                            <i class="bi bi-scissors"></i> Tách File
                        </button>
                    </form>

                    <div class="mt-4">
                        <h6>Hướng dẫn:</h6>
                        <ul class="small">
                            <li><strong>Hàng tiêu đề:</strong> hàng được dùng làm tiêu đề cho mỗi file sau khi tách</li>
                            <li><strong>Hàng bắt đầu tách:</strong> dữ liệu từ hàng này trở xuống mới được tách (phải lớn hơn hàng tiêu đề)</li>
                            <li><strong>Cột để tách:</strong> các dòng có cùng giá trị ở cột này sẽ được gom vào 1 file riêng</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function clearForm() {
            // Reset form về giá trị mặc định
            const form = document.querySelector('form');
            form.reset();
            document.getElementById('headerRow').value = 1;
            document.getElementById('startRow').value = 2;
            document.getElementById('splitColumn').value = 'A';
            document.getElementById('filePreview')?.classList.add('d-none');

            // Xóa các thông báo
            document.querySelectorAll('.alert').forEach(el => el.remove());

            // Xóa danh sách file
            document.querySelector('.list-group')?.closest('div').remove();
            document.querySelector('.mb-3.d-flex')?.remove();
        }
    </script>
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
