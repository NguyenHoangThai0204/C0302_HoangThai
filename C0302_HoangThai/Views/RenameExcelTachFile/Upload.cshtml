@{
    ViewData["Title"] = "Tách File Excel theo Nhóm";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0"><i class="bi bi-file-earmark-excel"></i> Tách File Excel theo Nhóm Invoice</h3>
                </div>
                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                        </div>
                    }

                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @ViewBag.Success
                        </div>

                        <div class="mb-3 d-flex gap-2">
                            <a href="@Url.Action("DownloadZip", "RenameExcelTachFile", new { filePath = ViewBag.ZipPath })"
                               class="btn btn-success btn-lg flex-fill">
                                <i class="bi bi-download"></i> Tải về tất cả (@ViewBag.TotalFiles file)
                            </a>
                            <a href="@Url.Action("Upload", "RenameExcelTachFile")"
                               class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-counterclockwise"></i> Tách file mới
                            </a>
                        </div>

                        @if (ViewBag.Files != null)
                        {
                            <h5>Danh sách file đã tách:</h5>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-success">
                                        <tr>
                                            <th width="5%">#</th>
                                            <th width="30%">Nhóm nguồn</th>
                                            <th width="35%">Invoices trong nhóm</th>
                                            <th width="30%">Tên file xuất</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int idx = 1;
                                        }
                                        @foreach (var file in ViewBag.Files)
                                        {
                                            <tr>
                                                <td>@idx</td>
                                                <td><small class="text-muted">@file.OriginalGroup</small></td>
                                                <td><small>@file.Invoices</small></td>
                                                <td>
                                                    <i class="bi bi-file-earmark-excel text-success"></i>
                                                    <strong class="text-success">@file.NewName</strong>
                                                </td>
                                            </tr>
                                            idx++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (ViewBag.DebugLogs != null)
                        {
                            <details class="mt-3">
                                <summary class="text-muted small" style="cursor:pointer">
                                    <i class="bi bi-terminal"></i> Xem Debug Log
                                </summary>
                                <div class="card mt-2">
                                    <div class="card-body" style="max-height:300px;overflow:auto;font-family:monospace;font-size:12px;background:#f8f9fa;">
                                        @foreach (var log in ViewBag.DebugLogs)
                                        {
                                            <div>@log</div>
                                        }
                                    </div>
                                </div>
                            </details>
                        }
                    }

                    <form method="post" enctype="multipart/form-data"
                          asp-action="ProcessFiles" asp-controller="RenameExcelTachFile" class="mt-4">

                        <div class="mb-3">
                            <label for="excelFile" class="form-label fw-bold">
                                <i class="bi bi-file-earmark-excel"></i> Chọn file Excel (.xlsx):
                            </label>
                            <input type="file"
                                   class="form-control form-control-lg"
                                   id="excelFile"
                                   name="excelFile"
                                   accept=".xlsx"
                                   required>
                            <div class="form-text">Chỉ chấp nhận file .xlsx</div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100">
                            <i class="bi bi-scissors"></i> Tách File
                        </button>
                    </form>

                    <div class="mt-4 p-3 bg-light rounded">
                        <h6><i class="bi bi-info-circle"></i> Hướng dẫn:</h6>
                        <ul class="small mb-0">
                            <li>Upload file Excel có nhiều nhóm, mỗi nhóm bắt đầu bằng dòng header <code>Week | Số INVOICE...</code></li>
                            <li>Mỗi nhóm sẽ được tách thành 1 file riêng (header + data rows)</li>
                            <li>Tên file đặt theo cột <strong>Số INVOICE Tổng / Số QLDN Nội bộ</strong>:</li>
                            <ul>
                                <li><code>ITA-0027832</code>, <code>ITA-0027833</code> → <code>ITA-0027832-33.xlsx</code></li>
                                <li><code>VIE-0008000</code>, <code>VIE-0008001</code> → <code>VIE-0008000-01.xlsx</code></li>
                                <li><code>ITA-0027999</code>, <code>VIE-0008000</code>, <code>VIE-0008001</code> → <code>ITA-0027999-8000-8001.xlsx</code></li>
                            </ul>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
