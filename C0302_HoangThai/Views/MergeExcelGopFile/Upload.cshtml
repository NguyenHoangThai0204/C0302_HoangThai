@{
    ViewData["Title"] = "Gộp File Excel";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-file-earmark-excel"></i> Gộp File Excel (từ ZIP đã tách)</h3>
                </div>
                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                        </div>
                    }

                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @ViewBag.Success
                        </div>

                        <div class="mb-3 d-flex gap-2">
                            <a href="@Url.Action("DownloadFile", "MergeExcelGopFile", new { filePath = ViewBag.OutputPath })"
                               class="btn btn-primary btn-lg flex-fill">
                                <i class="bi bi-download"></i> Tải file đã gộp (@ViewBag.OutputFileName)
                            </a>
                            <a href="@Url.Action("Upload", "MergeExcelGopFile")"
                               class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-counterclockwise"></i> Gộp file mới
                            </a>
                        </div>

                        @if (ViewBag.Blocks != null)
                        {
                            <h5>Thứ tự gộp (đã sắp xếp theo cột D tăng dần):</h5>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-primary">
                                        <tr>
                                            <th width="5%">#</th>
                                            <th width="45%">Tên file nguồn</th>
                                            <th width="20%">Ngày mốc (cột D)</th>
                                            <th width="15%">Số dòng dữ liệu</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int idx = 1;
                                        }
                                        @foreach (var block in ViewBag.Blocks)
                                        {
                                            <tr>
                                                <td>@idx</td>
                                                <td>
                                                    <i class="bi bi-file-earmark-excel text-primary"></i>
                                                    <strong>@block.FileName</strong>
                                                </td>
                                                <td>
                                                    @(block.SortDate != null ? ((DateTime)block.SortDate).ToString("dd/MM/yyyy") : "(không có ngày)")
                                                </td>
                                                <td>@block.DataRowCount</td>
                                            </tr>
                                            idx++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (ViewBag.DebugLogs != null)
                        {
                            <details class="mt-3">
                                <summary class="text-muted small" style="cursor:pointer">
                                    <i class="bi bi-terminal"></i> Xem Debug Log
                                </summary>
                                <div class="card mt-2">
                                    <div class="card-body" style="max-height:300px;overflow:auto;font-family:monospace;font-size:12px;background:#f8f9fa;">
                                        @foreach (var log in ViewBag.DebugLogs)
                                        {
                                            <div>@log</div>
                                        }
                                    </div>
                                </div>
                            </details>
                        }
                    }

                    <form method="post" enctype="multipart/form-data"
                          asp-action="ProcessMerge" asp-controller="MergeExcelGopFile" class="mt-4">

                        <div class="mb-3">
                            <label for="zipFile" class="form-label fw-bold">
                                <i class="bi bi-file-earmark-zip"></i> Chọn file ZIP chứa các file Excel cần gộp:
                            </label>
                            <input type="file"
                                   class="form-control form-control-lg"
                                   id="zipFile"
                                   name="zipFile"
                                   accept=".zip"
                                   required>
                            <div class="form-text">Chỉ chấp nhận file .zip (thường là file tải về từ chức năng Tách)</div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-union"></i> Gộp File
                        </button>
                    </form>

                    <div class="mt-4 p-3 bg-light rounded">
                        <h6><i class="bi bi-info-circle"></i> Hướng dẫn:</h6>
                        <ul class="small mb-0">
                            <li>Upload 1 file <strong>.zip</strong> chứa nhiều file .xlsx (ví dụ: file zip tải về từ chức năng Tách).</li>
                            <li>Mỗi file .xlsx trong zip sẽ trở thành 1 "block" (giữ nguyên header + dữ liệu của chính nó).</li>
                            <li>Các block được sắp xếp <strong>tăng dần theo cột D (Date)</strong>, lấy ngày sớm nhất tìm thấy trong mỗi file làm mốc sort.</li>
                            <li>Giữa 2 block liền kề sẽ chèn 1 dòng trống, cột A ghi chữ <code>X</code> để phân cách.</li>
                            <li>Kết quả trả về là <strong>1 file Excel duy nhất</strong> chứa toàn bộ dữ liệu đã gộp và sắp xếp.</li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
