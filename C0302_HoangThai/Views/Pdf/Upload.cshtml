@using C0302_HoangThai.Models
@{
    var workspace = new OcrWorkspaceModel(
        "Tờ khai nhập khẩu · Bản tự động",
        "Nhận dạng số tờ khai và tự xác định nhóm trang trong PDF.",
        "SplitPdf", "RenameFiles", "file",
        "Mở Mapping.xlsx, kiểm tra số tờ khai và điền cột Tên mới.");
    ViewData["Title"] = workspace.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/dist/css/CSS0302/ocr-workspace.css" asp-append-version="true" />
}

<div class="ocr-workspace" lang="vi">
    <partial name="_OcrWorkspace" model="workspace" />
</div>

@section Scripts {
    <script type="module" src="~/dist/js/J0302/ocr-workspace.js" asp-append-version="true"></script>
}
