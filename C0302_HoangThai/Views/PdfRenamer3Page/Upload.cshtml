@{
    ViewData["Title"] = "Đổi tên File PDF";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0"><i class="bi bi-file-pdf"></i> Đổi tên PDF theo Số quản lý nội bộ</h3>
                </div>
                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                        </div>
                    }

                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @ViewBag.Success
                        </div>

                        <div class="mb-3 d-flex gap-2">
                            <a href="@Url.Action("DownloadZip", "PdfRenamer3Page", new { filePath = ViewBag.ZipPath })"
                               class="btn btn-success btn-lg flex-fill">
                                <i class="bi bi-download"></i> Tải về tất cả (@ViewBag.TotalFiles file)
                            </a>
                            <a href="@Url.Action("Upload", "PdfRenamer3Page")"
                               class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-counterclockwise"></i> Đổi tên mới
                            </a>
                        </div>

                        @if (ViewBag.Files != null)
                        {
                            <h5>Danh sách file đã đổi tên:</h5>
                            <div class="list-group mb-3">
                                @foreach (var file in ViewBag.Files)
                                {
                                    <div class="list-group-item">
                                        <i class="bi bi-file-pdf text-danger"></i>
                                        <span class="text-muted small">@file.OriginalName</span>
                                        <i class="bi bi-arrow-right mx-2"></i>
                                        <strong>@file.FileName</strong>
                                    </div>
                                }
                            </div>
                        }

                        @if (ViewBag.DebugLogs != null)
                        {
                            <details class="mt-3">
                                <summary class="text-muted small" style="cursor:pointer">Xem debug log</summary>
                                <pre class="small bg-light p-2 mt-2" style="max-height:300px;overflow-y:auto">@string.Join("\n", ViewBag.DebugLogs)</pre>
                            </details>
                        }
                    }

                    <form method="post" enctype="multipart/form-data" asp-action="Upload" asp-controller="PdfRenamer3Page" class="mt-4">
                        <div class="mb-3">
                            <label class="form-label">Chọn file PDF (có thể chọn nhiều):</label>
                            <input type="file"
                                   class="form-control"
                                   name="pdfFiles"
                                   accept=".pdf"
                                   multiple>
                            <div class="form-text">Chấp nhận nhiều file .pdf cùng lúc</div>
                        </div>

                        @* <div class="mb-3">
                            <label class="form-label">Hoặc upload file ZIP chứa PDF:</label>
                            <input type="file"
                                   class="form-control"
                                   name="zipFile"
                                   accept=".zip">
                        </div> *@

                        <button type="submit" class="btn btn-danger btn-lg w-100">
                            <i class="bi bi-pencil-square"></i> Đổi tên
                        </button>
                    </form>

                    <div class="mt-4">
                        <h6>Hướng dẫn:</h6>
                        <ul class="small">
                            <li>Upload file PDF (1 hoặc nhiều file)</li>
                            <li>Tên file được lấy từ trường <strong>Số quản lý của nội bộ doanh nghiệp</strong> trên trang đầu</li>
                            <li>Ví dụ: <code>ITA-0027652.pdf</code></li>
                            <li>Nếu không tìm được, tên file sẽ là <code>Unknown.pdf</code></li>
                            <li>File PDF giữ nguyên toàn bộ trang, chỉ đổi tên</li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
