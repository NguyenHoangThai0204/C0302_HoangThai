﻿@{
ViewData["Title"] = "Tách PDF theo Số tờ khai";
}

<style>

    body {
        background: #f4f6fb;
        font-family: 'Segoe UI', sans-serif;
    }

    .page-container {
        width: 90%;
        max-width: 1300px;
        margin: 30px auto;
    }

    .page-title {
        text-align: center;
        font-size: 34px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 35px;
    }

    .grid-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .card-box {
        background: #fff;
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        border: 1px solid #edf2f7;
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
    }

    .card-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: white;
    }

    .icon-blue {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
    }

    .icon-green {
        background: linear-gradient(135deg,#16a34a,#15803d);
    }

    .card-title {
        font-size: 24px;
        font-weight: 700;
        color: #111827;
    }

    .card-sub {
        color: #64748b;
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: #334155;
    }

    .file-input {
        width: 100%;
        padding: 14px;
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        background: #f8fafc;
        transition: all 0.2s ease;
    }

        .file-input:hover {
            border-color: #2563eb;
            background: #eff6ff;
        }

    .btn-submit {
        width: 100%;
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-size: 16px;
        font-weight: 700;
        color: white;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 10px;
    }

        .btn-submit:hover {
            transform: translateY(-1px);
            opacity: 0.95;
        }

    .btn-blue {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
    }

    .btn-green {
        background: linear-gradient(135deg,#16a34a,#15803d);
    }

    .loading {
        display: none;
        text-align: center;
        margin-top: 16px;
        color: #475569;
        font-weight: 600;
    }

    .note-box {
        margin-top: 10px;
        background: #f8fafc;
        border-radius: 12px;
        padding: 18px;
        border-left: 5px solid #2563eb;
    }

        .note-box ul {
            margin: 0;
            padding-left: 18px;
        }

        .note-box li {
            margin-bottom: 10px;
            color: #475569;
            line-height: 1.6;
        }

    @@media(max-width: 992px) {

        .grid-layout {
            grid-template-columns: 1fr;
        }

        .page-container {
            width: 95%;
        }
    }

</style>

<div class="page-container">

    <div class="grid-layout">

        <!-- TÁCH PDF -->
        <div class="card-box">

            <div class="card-header">

                <div class="card-icon icon-blue">
                    ✂️
                </div>

                <div>
                    <div class="card-title">
                        Tách từng trang PDF
                    </div>
                </div>

            </div>

            <div class="card-sub">
                Mỗi trang PDF sẽ được tách thành 1 file riêng.<br />
                Hệ thống tự đọc:
                <b>Invoice #</b> +
                <b>AWB/B/L No.</b> +
                <b>Original invoice #</b> (từ bảng Control Sheet)
                và ghi vào file Mapping.xlsx.
            </div>

            <form id="form-step0"
                  asp-action="SplitEachPage"
                  asp-controller="PdfRenamerPDFCu"
                  method="post"
                  enctype="multipart/form-data">

                <div class="form-group">
                    <label class="form-label">
                        Chọn file PDF
                    </label>

                    <input type="file"
                           name="file"
                           class="file-input"
                           accept=".pdf"
                           required />
                </div>

                <button class="btn-submit btn-blue"
                        id="btn-step0">
                    ✂️ Tách PDF ngay
                </button>

                <div class="loading"
                     id="loading-step0">
                    ⏳ Đang xử lý PDF...
                </div>

            </form>

            <div class="note-box">

                <ul>
                    <li>Upload 1 file PDF nhiều trang</li>

                    <li>
                        Mỗi trang sẽ thành 1 file PDF riêng
                    </li>

                    <li>
                        Tự tạo file Mapping.xlsx
                    </li>

                    <li>
                        ZIP tải về gồm:
                        PDF + Mapping.xlsx
                    </li>
                </ul>

            </div>

        </div>

        <!-- RENAME -->
        <div class="card-box">

            <div class="card-header">

                <div class="card-icon icon-green">
                    📝
                </div>

                <div>
                    <div class="card-title">
                        Rename theo Excel
                    </div>
                </div>

            </div>

            <div class="card-sub">
                Upload ZIP chứa PDF và file Mapping.xlsx.<br />
                Hệ thống sẽ rename file theo cột
                <b>Tên mới</b>.
            </div>

            <form id="form-step1"
                  asp-action="RenameByExcel"
                  asp-controller="PdfRenamerPDFCu"
                  method="post"
                  enctype="multipart/form-data">

                <div class="form-group">

                    <label class="form-label">
                        Chọn file ZIP
                    </label>

                    <input type="file"
                           name="zipFile"
                           accept=".zip"
                           class="file-input"
                           required />
                </div>

                <div class="form-group">

                    <label class="form-label">
                        Chọn Mapping.xlsx
                    </label>

                    <input type="file"
                           name="excelFile"
                           accept=".xlsx"
                           class="file-input"
                           required />
                </div>

                <button type="submit"
                        class="btn-submit btn-green"
                        id="btn-step1">

                    🚀 Rename ngay

                </button>

                <div class="loading"
                     id="loading-step1">

                    ⏳ Đang rename file...

                </div>

            </form>

            <div class="note-box">

                <ul>

                    <li>
                        Cột A = Tên file cũ
                    </li>

                    <li>
                        Cột F = Tên mới
                    </li>

                    <li>
                        Tự tránh trùng tên file
                    </li>

                    <li>
                        Tự giữ extension .pdf
                    </li>

                </ul>

            </div>

        </div>

    </div>

</div>

<script>

    async function handleForm(formId, loadingId, btnId) {

        const form = document.getElementById(formId);

        form.addEventListener('submit', async function (e) {

            e.preventDefault();

            const loading =
                document.getElementById(loadingId);

            const btn =
                document.getElementById(btnId);

            loading.style.display = 'block';

            btn.disabled = true;

            try {

                const formData =
                    new FormData(form);

                const response =
                    await fetch(form.action, {
                        method: 'POST',
                        body: formData
                    });

                if (!response.ok) {

                    const err =
                        await response.text();

                    alert(err);

                    return;
                }

                const disposition =
                    response.headers.get('Content-Disposition') || '';

                let fileName = 'download.zip';

                const match =
                    disposition.match(/filename[^;=\n]*=(?:UTF-8''|["']?)([^"';\n]*)/i);

                if (match && match[1]) {

                    fileName =
                        decodeURIComponent(
                            match[1].replace(/\+/g, ' ')
                        );
                }

                const blob =
                    await response.blob();

                const url =
                    window.URL.createObjectURL(blob);

                const a =
                    document.createElement('a');

                a.href = url;

                a.download = fileName;

                document.body.appendChild(a);

                a.click();

                a.remove();

                window.URL.revokeObjectURL(url);
            }
            catch (err) {

                alert(err.message);
            }
            finally {

                loading.style.display = 'none';

                btn.disabled = false;
            }
        });
    }

    handleForm(
        'form-step0',
        'loading-step0',
        'btn-step0'
    );

    handleForm(
        'form-step1',
        'loading-step1',
        'btn-step1'
    );

</script>